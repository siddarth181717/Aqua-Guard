# AquaGuard Backend Environment Configuration
PROJECT_NAME=AquaGuard
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=aquaguard_super_secret_jwt_key_change_in_production_2026

# Database Settings (PostgreSQL + PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aquaguard_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aquaguard_db

# CORS Settings (JSON list string or comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Google Earth Engine Cloud Project ID
GEE_PROJECT_ID=aquaguard-gee-project
