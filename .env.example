# AquaGuard Environment Variable Configuration
# -----------------------------------------------

# Application Environment (development, testing, production)
ENVIRONMENT=development

# Backend Settings
PROJECT_NAME="AquaGuard"
API_V1_STR="/api/v1"
SECRET_KEY="aquaguard_super_secret_jwt_key_change_in_production_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL + PostGIS Database Credentials
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aquaguard_db
POSTGIS_DATABASE=aquaguard_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aquaguard_db

# ML & Data Paths
ML_MODEL_PATH=models/restoration_priority_model.pkl
DATA_DIRECTORY=data

# CORS Origins (JSON list or comma-separated strings)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# External Data & Satellite Credentials
GEE_PROJECT_ID=aquaguard-gee-project
BHUVAN_API_KEY=your_bhuvan_api_key_here
INDIA_WRIS_API_KEY=your_india_wris_api_key_here
